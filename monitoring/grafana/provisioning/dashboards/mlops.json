{
  "title": "MLOps API Dashboard",
  "uid": "mlops-api",
  "schemaVersion": 36,
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/min)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{
        "expr": "rate(http_requests_total{job=\"mlops-api\"}[1m]) * 60",
        "legendFormat": "{{method}} {{handler}}"
      }]
    },
    {
      "id": 2,
      "title": "P95 Latency (s)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"mlops-api\"}[5m]))",
        "legendFormat": "p95 latency"
      }]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "rate(http_requests_total{job=\"mlops-api\", status=~\"5..\"}[1m])",
        "legendFormat": "5xx errors"
      }]
    },
    {
      "id": 4,
      "title": "Predictions /predict",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "increase(http_requests_total{job=\"mlops-api\", handler=\"/predict\"}[1h])",
        "legendFormat": "predictions (1h)"
      }]
    }
  ]
}
